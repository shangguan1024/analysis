        <mxCell id="c-title" value="路由层 routeTopology: 输入 · 内部匹配规则 · 输出" style="text;html=1;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1400" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c-inq" value="输入① query: string&lt;br&gt;用户原始 query — 语义信号&lt;br&gt;例: 「做一个忍者跑酷游戏」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-ine" value="输入② explicitTopology&lt;br&gt;&#39;auto&#39; | &#39;app&#39; | &#39;game&#39;&lt;br&gt;来源: Dashboard 表单 projectType&lt;br&gt;&#39;auto&#39; = 未显式选择 (新默认值)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-rc" value="routeTopology 内部执行 — L7 scene-template-node/src/services/topology-router.ts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="510" height="570" as="geometry" />
        </mxCell>
        <mxCell id="c-s1" value="① 显式短路&lt;br&gt;explicitTopology ≠ &#39;auto&#39;&lt;br&gt;→ {topologyId=显式值, source:&#39;explicit&#39;} 零 LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="150" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c-s2" value="② LLM 判定 — 一次轻量调用&lt;br&gt;system = 判定规则 (由 TOPOLOGY_CATALOG 渲染)&lt;br&gt;user = query&lt;br&gt;maxTokens=50 · 60s 超时 · loadLlmConfig(&#39;topology-router&#39;)&lt;br&gt;(纯分类任务, 可配最便宜模型)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="225" width="470" height="95" as="geometry" />
        </mxCell>
        <mxCell id="c-s3" value="③ 归一化 + 值域校验&lt;br&gt;raw → trim / 小写 / 去引号&lt;br&gt;∈ TOPOLOGY_CATALOG id 集合?&lt;br&gt;合法 → {topologyId, source:&#39;llm&#39;}&lt;br&gt;非法 → {topologyId:&#39;app&#39;, source:&#39;fallback&#39;}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="335" width="470" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c-s4" value="④ 异常降级 — 永不 throw&lt;br&gt;stopReason error/aborted → error:&#39;llm-error&#39;&lt;br&gt;Agent/apiKey/config 异常 → error:&#39;config-error&#39;&lt;br&gt;一律兜底 topologyId=&#39;app&#39;, 创建不阻断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="440" width="470" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c-cat" value="TOPOLOGY_CATALOG — 单一真相源 (数据驱动)&lt;br&gt;app: 常规 Web 应用 — 内容展示/表单/列表详情/工具/导购等页面型&lt;br&gt;game: 游戏 — 玩法驱动(跑酷/射击/益智/模拟经营), 实时渲染/关卡/操控/得分语义&lt;br&gt;&lt;b&gt;扩展垂类 = 加一行 {id, description}, 判定代码零改动&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="535" width="470" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c-rules" value="匹配规则 — LLM system prompt 的边界判定" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="460" height="310" as="geometry" />
        </mxCell>
        <mxCell id="c-rulesbox" value="① 明确玩法语义 (关卡/角色操控/得分/物理引擎) → game&lt;br&gt;② 页面型应用 (即使含游戏化元素: 积分/排行榜/成就) → app&lt;br&gt;③ 混合形态 (游戏官网/游戏社区) → 按核心目的:&lt;br&gt;    玩 → game · 看 → app&lt;br&gt;④ 无法确定 → app&lt;br&gt;&lt;br&gt;&lt;b&gt;兜底偏置: 宁可漏判 game, 不可误判 game&lt;/b&gt;&lt;br&gt;(漏判 = 产物形态普通化, 可迭代纠正;&lt;br&gt; 误判 = 走错管线, 不可逆)&lt;br&gt;&lt;br&gt;判定质量取决于 description 的区分性&lt;br&gt;(写清「什么选我 + 什么不选我」)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1000" y="145" width="420" height="250" as="geometry" />
        </mxCell>
        <mxCell id="c-out" value="输出 RouteTopologyResult" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="980" y="440" width="460" height="230" as="geometry" />
        </mxCell>
        <mxCell id="c-outbox" value="· topologyId: &#39;app&#39; | &#39;game&#39;&lt;br&gt;    恒非空 — 失败兜底 &#39;app&#39;&lt;br&gt;· source: &#39;explicit&#39; | &#39;llm&#39; | &#39;fallback&#39;&lt;br&gt;    决策来源 (可观测性)&lt;br&gt;· raw: LLM 原始输出&lt;br&gt;    (排障; 非 LLM 来源为 null)&lt;br&gt;· error: &#39;llm-error&#39; | &#39;config-error&#39; | null" style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1000" y="480" width="420" height="175" as="geometry" />
        </mxCell>
        <mxCell id="c-cons" value="消费链路 (零新契约)&lt;br&gt;topologyId → server 分派 → job.type&lt;br&gt;→ JOB_RUNS 查表 → YAML DAG → runWorkflow&lt;br&gt;→ scene-template / 设计节点不受影响" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="980" y="700" width="460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ce1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-inq" target="c-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-ine" target="c-s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce3" value="&#39;auto&#39; 才进 LLM" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=12;" edge="1" parent="1" source="c-s1" target="c-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce4" value="渲染进 system prompt" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="c-cat" target="c-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce5" value="判定规则来源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="c-rules" target="c-s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-s2" target="c-s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-s3" target="c-s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-s3" target="c-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-s4" target="c-out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ce10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="c-out" target="c-cons">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
